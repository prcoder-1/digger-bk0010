+#define CONCAT1(a, b) CONCAT2(a, b)
+#define CONCAT2(a, b) a ## b
+#define SYM(x) CONCAT1(__USER_LABEL_PREFIX__, x)
+
+	.text
+	.even
+	.globl	SYM(__mulhi3)
+SYM(__mulhi3):
+	mov	r2, -(sp)	/* preserve call-saved r2                  */
+	clr	r2		/* r2 = accumulated product                */
+	mov	04(sp), r0	/* r0 = multiplier (first argument)        */
+	mov	06(sp), r1	/* r1 = multiplicand (second argument)     */
+	tst	r0
+	beq	2f		/* multiplier == 0 -> product 0            */
+1:
+	clc			/* shift multiplier right, LSB -> C        */
+	ror	r0
+	bcc	3f		/* that bit clear -> skip the add          */
+	add	r1, r2		/* bit set -> add the shifted multiplicand */
+3:
+	asl	r1		/* multiplicand <<= 1 for the next bit     */
+	tst	r0
+	bne	1b		/* more multiplier bits remain             */
+2:
+	mov	r2, r0		/* return product in r0                    */
+	mov	(sp)+, r2
+	rts	pc
