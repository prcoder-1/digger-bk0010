+/* Signed 16-bit division and remainder for PDP-11 targets without the
+   EIS DIV instruction (e.g. -m10 / KP1801VM1).  These mirror the SImode
+   __divsi3 / __modsi3 in libgcc's generic divmod.c, but for HImode and
+   built on __udivmodhi4, which pdp11's libgcc already provides
+   (via udivmodhi4.c in t-pdp11).  Without them a bare link fails with
+   "undefined reference to __divhi3 / __modhi3".
